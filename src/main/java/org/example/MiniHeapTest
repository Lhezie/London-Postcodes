public class MinHeapTest {
    public static void main(String[] args) {
        MinHeap heap = new MinHeap(10); // Capacity 10

        // Insert some postcodes
        heap.Insert("W1A 1AA");
        heap.Insert("E1 6AN");
        heap.Insert("N1 9AL");
        heap.Insert("SW1A 0AA");

        // Print heap contents
        System.out.println("Heap contents:");
        heap.printHeap();

        // Test Count()
        System.out.println("Number of postcodes in heap: " + heap.Count());

        // Test Search()
        System.out.println("Search for E1 6AN: " + heap.Search("E1 6AN")); // Should be true
        System.out.println("Search for SE1 7PB: " + heap.Search("SE1 7PB")); // Should be false

        // Test ExtractMinimum()
        System.out.println("Extract minimum (smallest postcode): " + heap.ExtractMinimum());

        // Print heap after extracting minimum
        System.out.println("Heap after extracting minimum:");
        heap.printHeap();

        // Test InOrder()
        System.out.println("Postcodes in alphabetical order:");
        String[] sortedPostcodes = heap.InOrder();
        for (String postcode : sortedPostcodes) {
            System.out.println(postcode);
        }
    }
}


