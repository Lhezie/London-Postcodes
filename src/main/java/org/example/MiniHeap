package org.example.MinHeap;

import java.util.ArrayList;
import java.util.Collections;

public class MinHeap {
    private ArrayList<HeapNode> heap;

    public MinHeap() {
        heap = new ArrayList<>();
    }

    public void Insert(long encodedPostCode, String originalPostCode) {
        HeapNode newNode = new HeapNode(encodedPostCode, originalPostCode);
        heap.add(newNode);
        HeapifyUp(heap.size() - 1);
    }

    public boolean Search(long encodedPostCode) {
        for (HeapNode node : heap) {
            if (node.encodedPostCode == encodedPostCode) {
                return true;
            }
        }
        return false;
    }

    public void Delete(long encodedPostCode) {
        int indexToRemove = -1;
        for (int i = 0; i < heap.size(); i++) {
            if (heap.get(i).encodedPostCode == encodedPostCode) {
                indexToRemove = i;
                break;
            }
        }
        if (indexToRemove == -1) return; // postcode not found

        int lastIndex = heap.size() - 1;
        Swap(indexToRemove, lastIndex);
        heap.remove(lastIndex);
        HeapifyDown(indexToRemove);
    }

    public int Count() {
        return heap.size();
    }

    public ArrayList<String> InOrder() {
        ArrayList<String> result = new ArrayList<>();
        for (HeapNode node : heap) {
            result.add(node.originalPostCode);
        }
        Collections.sort(result); // Alphabetical order
        return result;
    }

    private void Swap(int i, int j) {
        HeapNode temp = heap.get(i);
        heap.set(i, heap.get(j));
        heap.set(j, temp);
    }

    private void HeapifyUp(int index) {
        while (index > 0) {
            int parentIndex = (index - 1) / 2;
            if (heap.get(index).encodedPostCode < heap.get(parentIndex).encodedPostCode) {
                Swap(index, parentIndex);
                index = parentIndex;
            } else {
                break;
            }
        }
    }

    private void HeapifyDown(int index) {
        int leftChild, rightChild, minIndex;

        while (index < heap.size()) {
            leftChild = 2 * index + 1;
            rightChild = 2 * index + 2;
            minIndex = index;

            if (leftChild < heap.size() && heap.get(leftChild).encodedPostCode < heap.get(minIndex).encodedPostCode) {
                minIndex = leftChild;
            }
            if (rightChild < heap.size() && heap.get(rightChild).encodedPostCode < heap.get(minIndex).encodedPostCode) {
                minIndex = rightChild;
            }
            if (minIndex != index) {
                Swap(index, minIndex);
                index = minIndex;
            } else {
                break;
            }
        }
    }
}

