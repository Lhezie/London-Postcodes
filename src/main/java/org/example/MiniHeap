public class MinHeap {
    private int capacity;
    private int size;
    private String[] heap;
    private int insertCount;
    private int deleteCount;
    private int searchCount;

    public MinHeap(int capacity) {
        this.capacity = capacity;
        this.size = 0;
        this.heap = new String[capacity];
        this.insertCount = 0;
        this.deleteCount = 0;
        this.searchCount = 0;
    }

    private int getParent(int index) {
        return (index - 1) / 2;
    }

    private int getLeftChild(int index) {
        return 2 * index + 1;
    }

    private int getRightChild(int index) {
        return 2 * index + 2;
    }

    private void swap(int indexOne, int indexTwo) {
        String temp = heap[indexOne];
        heap[indexOne] = heap[indexTwo];
        heap[indexTwo] = temp;
    }

    private void expandCapacity() {
        int newCapacity = capacity * 2;
        String[] newHeap = new String[newCapacity];
        for (int i = 0; i < size; i++) {
            newHeap[i] = heap[i];
        }
        heap = newHeap;
        capacity = newCapacity;
    }

    public void Insert(String postcode) {
        if (size == capacity) {
            expandCapacity();
        }
        heap[size] = postcode;
        int currentIndex = size;
        size++;
        insertCount++;

        while (currentIndex > 0 && heap[currentIndex].compareTo(heap[getParent(currentIndex)]) < 0) {
            swap(currentIndex, getParent(currentIndex));
            currentIndex = getParent(currentIndex);
        }
    }

    private void heapifyDown(int index) {
        int smallest = index;
        int left = getLeftChild(index);
        int right = getRightChild(index);

        if (left < size && heap[left].compareTo(heap[smallest]) < 0) {
            smallest = left;
        }
        if (right < size && heap[right].compareTo(heap[smallest]) < 0) {
            smallest = right;
        }

        if (smallest != index) {
            swap(index, smallest);
            heapifyDown(smallest);
        }
    }

    public String ExtractMinimum() {
        if (size == 0) {
            throw new IllegalStateException("Heap is empty");
        }

        String minValue = heap[0];
        heap[0] = heap[size - 1];
        size--;
        heapifyDown(0);
        deleteCount++;
        return minValue;
    }

    public int Search(String postcode) {
        for (int i = 0; i < size; i++) {
            if (heap[i].equals(postcode)) {
                searchCount++;
                return i; // return the index if found
            }
        }
        searchCount++;
        return -1; // return -1 if not found
    }

    public int Count() {
        return size;
    }

    public String[] InOrder() {
        String[] sorted = new String[size];
        MinHeap tempHeap = new MinHeap(capacity);

        // Copy all elements into a temp heap to not destroy the original
        for (int i = 0; i < size; i++) {
            tempHeap.Insert(heap[i]);
        }

        // Extract elements one by one to build the sorted array
        int i = 0;
        while (!tempHeap.isEmpty()) {
            sorted[i++] = tempHeap.ExtractMinimum();
        }

        return sorted;
    }

    public boolean isEmpty() {
        return size == 0;
    }

    public void printHeap() {
        for (int i = 0; i < size; i++) {
            System.out.print(heap[i] + " ");
        }
        System.out.println();
    }

    // Extra: Get number of Insert, Delete, Search operations
    public int getInsertCount() {
        return insertCount;
    }

    public int getDeleteCount() {
        return deleteCount;
    }

    public int getSearchCount() {
        return searchCount;
    }
}


